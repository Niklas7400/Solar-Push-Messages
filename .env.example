# Datenquelle: "modbus" (lokal, nahezu Echtzeit, braucht LAN-Zugriff auf den
# Wechselrichter) oder "cloud" (FusionSolar-Account, kein LAN nötig, dafür
# ~5 Minuten Verzögerung und eine inoffizielle, jederzeit änderbare API).
DATA_SOURCE=modbus

# --- nur für DATA_SOURCE=modbus ---
# IP-Adresse deines Huawei SUN2000 im lokalen Netz (Router-Oberfläche oder
# FusionSolar App -> Anlage -> Gerätename prüfen, oder 192.168.200.1 wenn du
# dich per WLAN-Hotspot des Wechselrichters verbindest).
INVERTER_HOST=192.168.200.1
INVERTER_PORT=502
INVERTER_SLAVE_ID=0

# --- nur für DATA_SOURCE=cloud ---
# Dieselben Zugangsdaten wie in der FusionSolar App/Website.
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_PASSWORD=
# Subdomain aus der URL, wenn du dich im Browser einloggst, z.B.
# https://region01eu5.fusionsolar.huawei.com -> region01eu5
FUSIONSOLAR_SUBDOMAIN=region01eu5
# Optional: nur nötig, wenn der Account mehrere Anlagen hat und nicht die
# erste gemeint ist (siehe scripts/dump_fusion_solar_flow.py -> "Plant IDs").
FUSIONSOLAR_PLANT_ID=

# ntfy.sh Topic - frei erfundener, schwer zu erratender Name (kein Leerzeichen).
# In der ntfy-App (Android/iOS) exakt dasselbe Topic abonnieren.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=mein-solar-xyz123

# Abfrageintervall in Sekunden.
POLL_INTERVAL_SECONDS=60

# Ab wie viel Watt Netz-Überschuss (Einspeisung) "jetzt einschalten" gemeldet wird.
INCREASE_THRESHOLD_W=1000

# Ab wie viel Watt Speicher-Entladeleistung "Verbrauch reduzieren" gemeldet
# wird (nicht Netzbezug - bei einem Speicher deckt der meist erst den
# Netzbezug ab, daher ist "Speicher wird stark entladen" das frühere Signal).
DECREASE_THRESHOLD_W=1000

# Ab welchem Ladestand (%) der Speicher als "niedrig" gemeldet wird.
BATTERY_LOW_SOC_PCT=95
# Puffer um die Speicherstand-Schwelle herum (Prozentpunkte).
BATTERY_LOW_HYSTERESIS_PCT=2

# Ab wie viel Watt Netzbezug eine Warnung kommt (unabhängig von
# DECREASE_THRESHOLD_W). Gedacht als Anomalie-Alarm - z.B. im Sommer, wenn
# PV + Speicher den Verbrauch eigentlich decken sollten und trotzdem Bezug
# vom Netz auftritt.
GRID_IMPORT_ALERT_W=200
# Diese Warnung feuert nur, wenn mindestens so viel PV-Leistung anliegt -
# sonst würde sie jede Nacht auslösen, sobald die Sonne weg ist.
GRID_IMPORT_ALERT_MIN_PV_W=500

# Einmal täglich (ab dieser Uhrzeit, 0-23) eine Zusammenfassung schicken:
# PV-Ertrag, Einspeisung, Netzbezug seit Prozessstart/Mitternacht. Zählt nur
# die Zeit, in der der Dienst tatsächlich lief (kein Backfill bei Neustart).
DAILY_SUMMARY_ENABLED=true
DAILY_SUMMARY_HOUR=21

# Puffer um die Watt-Schwellen herum, damit bei Werten nahe der Grenze nicht
# staendig hin- und her benachrichtigt wird.
HYSTERESIS_W=200

# Mindestabstand zwischen zwei Benachrichtigungen nach einem Zustandswechsel.
COOLDOWN_MINUTES=15

# Wenn der Überschuss/die Entladung dauerhaft anhält: nach dieser Zeit erneut erinnern.
RENOTIFY_MINUTES=45

# Vorzeichen des Netz-Leistungsmesswerts kalibrieren:
# true  = positiver Wert bedeutet Einspeisung/Überschuss (Standard bei den
#         meisten Huawei Smart Power Sensor Installationen)
# false = positiver Wert bedeutet Bezug vom Netz
# Mit --debug testen und beobachten, welche Einstellung zur Realität passt.
GRID_EXPORT_POSITIVE=true

# Vorzeichen der Speicher-Lade-/Entladeleistung kalibrieren:
# true  = positiver Wert bedeutet Laden (Standard, gegen echten
#         Entladevorgang verifiziert)
# false = positiver Wert bedeutet Entladen
BATTERY_CHARGE_POSITIVE=true

# ============================================================
# Nissan Leaf Ladestand-Push (nissan_leaf/main.py, separater Dienst)
# ============================================================

# Zugangsdaten der NissanConnect Services App (nur EU-Region unterstützt).
NISSAN_USERNAME=
NISSAN_PASSWORD=
# Optional: nur nötig, wenn der Account mehrere Fahrzeuge hat.
NISSAN_VIN=

# Eigenes ntfy-Topic/Server fürs Auto, falls nicht das gleiche wie oben
# (NTFY_URL/NTFY_TOPIC) verwendet werden soll.
NISSAN_NTFY_URL=
NISSAN_NTFY_TOPIC=

# Abfrageintervall in Sekunden. Bewusst deutlich größer als beim Solar-Teil -
# NissanConnect-Daten sind ohnehin nicht in Echtzeit, und zu häufiges Abfragen
# kann laut Community-Erfahrung zu Sperren führen.
NISSAN_POLL_INTERVAL_SECONDS=600

# Ab welchem Ladestand (%) benachrichtigt wird, plus Puffer gegen Flattern.
NISSAN_CHARGE_TARGET_PCT=80
NISSAN_HYSTERESIS_PCT=2

NISSAN_COOLDOWN_MINUTES=15
# Deutlich länger als beim Solar-Teil - eine Erinnerung "Auto ist fertig
# geladen, bitte abstecken" alle paar Minuten wäre nervig.
NISSAN_RENOTIFY_MINUTES=240

# Vor jeder Abfrage das Auto aktiv aufwecken (wie der Refresh-Button in der
# App), statt nur den ggf. stundenalten Cloud-Cache zu lesen. Wartezeit in
# Sekunden, bis das Auto seine frischen Daten gemeldet hat. Weckt das Auto
# bei jedem Poll-Intervall auf - EV-Communities bringen häufiges aktives
# Aufwecken mit zusätzlichem 12V-Batterieverbrauch in Verbindung; bei 10 Min.
# Intervall als gering eingeschätzt, im Zweifel NISSAN_POLL_INTERVAL_SECONDS
# erhöhen statt diesen Wert zu senken.
NISSAN_REFRESH_WAIT_SECONDS=25
